# Public site URL (canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=https://winala.ht

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (never prefix with NEXT_PUBLIC_). Used by the waitlist server action.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets — set with: npx supabase secrets set NAME=value
# INGEST_SECRET=            (shared with the Python model pipeline)
# PAYMENT_WEBHOOK_SECRET=   (shared with the payment aggregator / back-office)
